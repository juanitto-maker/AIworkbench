# Get context summary for status display
get_context_summary() {
    # Show ACTUAL context being used (MODE_UPLOADS), not just what's in .context_state
    # This ensures the footer accurately reflects what the API will receive
    if [[ ${#MODE_UPLOADS[@]} -gt 0 ]]; then
        local file_count=${#MODE_UPLOADS[@]}
        local image_count=0

        # Count images if get_context_images is available
        if type get_context_images &>/dev/null; then
            while IFS= read -r img; do
                [[ -n "$img" ]] && ((image_count++))
            done < <(get_context_images)
        fi

        if [[ $image_count -gt 0 ]]; then
            echo "$file_count file(s) ($image_count image(s))"
        else
            echo "$file_count file(s)"
        fi
    else
        # No in-memory context loaded, but check if persistent context exists (not loaded)
        if type context_state_exists &>/dev/null && context_state_exists; then
            local scan_count
            scan_count=$(context_state_get "last_scan.file_count" 2>/dev/null)
            if [[ -n "$scan_count" && "$scan_count" != "null" && "$scan_count" != "0" ]]; then
                # Show that context exists but is not loaded
                echo "none (saved: $scan_count files - use /contextload)"
            else
                echo "none"
            fi
        else
            echo "none"
        fi
    fi
}

# Get total session cost
get_session_cost() {
    local workspace logs_dir usage_log
    workspace="$(get_workspace 2>/dev/null)" || workspace="$HOME/.aiwb/workspace"
    logs_dir="$workspace/logs"
    usage_log="$logs_dir/usage.jsonl"

    if [[ ! -f "$usage_log" ]]; then
        echo "0.00"
        return
    fi

    # Sum costs from current session (today's entries)
    local total_cost
    if command -v jq &>/dev/null; then
        total_cost=$(jq -s 'map(.cost) | add // 0' "$usage_log" 2>/dev/null)
        printf "%.2f" "$total_cost" 2>/dev/null || echo "0.00"
    else
        echo "0.00"
    fi
}

# Get message count for current session
get_message_count() {
    local workspace logs_dir
    workspace="$(get_workspace 2>/dev/null)" || workspace="$HOME/.aiwb/workspace"
    logs_dir="$workspace/logs"

    # Count "USER:" lines in most recent chat log
    local latest_log
    latest_log=$(ls -t "$logs_dir"/chat_*.log 2>/dev/null | head -1)

    if [[ -f "$latest_log" ]]; then
        grep -c "^\\[.*\\] USER:" "$latest_log" 2>/dev/null || echo "0"
    else
        echo "0"
    fi
}

# Get last response cost
get_last_response_cost() {
    local workspace logs_dir
    workspace="$(get_workspace 2>/dev/null)" || workspace="$HOME/.aiwb/workspace"
    logs_dir="$workspace/logs"
    local usage_log="$logs_dir/usage.jsonl"

    if [[ ! -f "$usage_log" ]]; then
        echo "0.00"
        return
    fi

    # Get the last entry's cost
    local last_cost
    if command -v jq &>/dev/null; then
        last_cost=$(tail -1 "$usage_log" | jq -r '.cost // 0' 2>/dev/null)
        printf "%.4f" "$last_cost" 2>/dev/null || echo "0.00"
    else
        echo "0.00"
    fi
}

# Show status footer after AI response
show_status_footer() {
    local provider model
    provider="$(config_get model_provider)"
    model="$(config_get model_name)"

    # Get terminal width (default 80 for narrow screens)
    local term_width
    term_width=$(tput cols 2>/dev/null || echo "80")

    # Build model display (provider/model)
    local model_display="${provider}/${model}"

    # Get context summary
    local context_summary
    context_summary=$(get_context_summary)

    # Get cost stats
    local session_cost message_count last_cost
    session_cost=$(get_session_cost)
    last_cost=$(get_last_response_cost)
    message_count=$(get_message_count)

    # Line 1: Model only
    local line1_plain="Model: ${model_display}"
    if [[ ${#line1_plain} -gt $term_width ]]; then
        local max_len=$((term_width - 3))
        local truncated="${line1_plain:0:$max_len}..."
        line1="${truncated}"
    else
        line1="Model: ${BOLD}${model_display}${RESET}"
    fi

    # Line 2: Context only
    local line2_plain="Context: ${context_summary}"
    if [[ ${#line2_plain} -gt $term_width ]]; then
        local max_len=$((term_width - 3))
        local truncated="${line2_plain:0:$max_len}..."
        line2="${truncated}"
    else
        line2="Context: ${DIM}${context_summary}${RESET}"
    fi

    # Line 3: Cost (last + session total) + messages
    local cost_color="${GREEN}"
    local session_color="${GREEN}"

    if command -v bc &>/dev/null; then
        # Color last response cost
        if (( $(echo "$last_cost > 0.10" | bc -l 2>/dev/null) )); then
            cost_color="${RED}"
        elif (( $(echo "$last_cost > 0.01" | bc -l 2>/dev/null) )); then
            cost_color="${YELLOW}"
        fi

        # Color session total
        if (( $(echo "$session_cost > 1.00" | bc -l 2>/dev/null) )); then
            session_color="${RED}"
        elif (( $(echo "$session_cost > 0.10" | bc -l 2>/dev/null) )); then
            session_color="${YELLOW}"
        fi
    fi

    local line3_plain="Cost: \$${last_cost} this | \$${session_cost} total | Msgs: ${message_count} | /status"

    if [[ ${#line3_plain} -gt $term_width ]]; then
        local max_len=$((term_width - 3))
        local truncated="${line3_plain:0:$max_len}..."
        line3="${truncated}"
    else
        line3="Cost: ${cost_color}\$${last_cost}${RESET} this | ${session_color}\$${session_cost}${RESET} total | Msgs: ${message_count} | ${DIM}/status${RESET}"
    fi

    # Print all 3 lines using printf for proper color handling
    printf "%b\n" "$line1"
    printf "%b\n" "$line2"
    printf "%b\n" "$line3"
}

# Handle chat message
handle_chat_message() {
    local message="$1"
    local provider model
    provider="$(config_get model_provider)"
    model="$(config_get model_name)"

    # Build message with context using centralized function
    # This ensures chat respects MODE_UPLOADS and context clearing
    local enhanced_message
    enhanced_message=$(build_prompt_with_context "$message" "false")

    # Show blinking cursor while API call runs (as requested by user)
    ui_blink "Thinking..."

    # Call API without stderr suppression to see errors
    local response
    response=$(call_api "$enhanced_message" "$provider" "$model")
    local exit_code=$?

    # Clear the blinking cursor line
    ui_clear_line

    # Check if interrupted (exit code 130)
    if [[ $exit_code -eq 130 ]]; then
        echo ""
        return 130
    fi

    if [[ $exit_code -ne 0 ]]; then
        err "Failed to get response"
        return 1
    fi

    # Display response (redirect to stderr to avoid duplicate output)
    printf "\n" >&2
    printf "%b\n" "${BOLD}AI:${RESET}" >&2
    printf "%b\n" "${YELLOW}${response}${RESET}" >&2
    printf "\n" >&2

    # Track cost first (use enhanced_message to reflect actual tokens sent)
    track_usage "$provider" "$model" "$enhanced_message" "$response"

    # Show status footer (will include the cost just tracked)
    show_status_footer >&2
    echo "" >&2

    # Return only the response text for logging
    echo "$response"
}

# Track API usage and costs
track_usage() {
    local provider="$1"
    local model="$2"
    local input="$3"
    local output="$4"

    local input_tokens output_tokens cost
    input_tokens=$(estimate_tokens "$input")
    output_tokens=$(estimate_tokens "$output")
    cost=$(calculate_cost "$provider" "$model" "$input_tokens" "$output_tokens")

    # Save to usage log
    local workspace logs_dir
    workspace="$(get_workspace)"
    logs_dir="$workspace/logs"
    local usage_log="$logs_dir/usage.jsonl"

    local entry
    entry=$(jq -n \
        --arg provider "$provider" \
        --arg model "$model" \
        --arg in_tokens "$input_tokens" \
        --arg out_tokens "$output_tokens" \
        --arg cost "$cost" \
        --arg timestamp "$(date -Iseconds)" \
        '{provider: $provider, model: $model, input_tokens: ($in_tokens | tonumber), output_tokens: ($out_tokens | tonumber), cost: ($cost | tonumber), timestamp: $timestamp}')

    echo "$entry" >> "$usage_log"

    # Show cost if enabled
    if [[ "$(config_get preferences.show_costs)" == "true" ]]; then
        debug "Cost: \$${cost} USD (${input_tokens} in + ${output_tokens} out tokens)"
    fi
}

# Preflight cost estimation for context operations
preflight_estimate_cost() {
    local operation_type="$1"  # "scan", "load", "context"
    local input_text="${2:-}"
    local provider="${3:-$(config_get model_provider)}"
    local model="${4:-$(config_get model_name)}"

    # Estimate input tokens
    local input_tokens=0
    if [[ -n "$input_text" ]]; then
        # Estimate from provided text
        input_tokens=$(estimate_tokens "$input_text")
    elif type context_state_estimate_tokens &>/dev/null; then
        # Estimate from context files
        input_tokens=$(context_state_estimate_tokens)
    fi

    # If no tokens to estimate, return success
    if [[ $input_tokens -eq 0 ]]; then
        return 0
    fi

    # Estimate output tokens based on operation type
    local output_tokens=0
    case "$operation_type" in
        "scan"|"smartscan")
            # Scan operations: analysis output is usually 0.3x-0.5x input
            output_tokens=$((input_tokens / 2))
            ;;
        "load"|"context")
            # Context load: minimal output expected (just confirmation)
            output_tokens=$((input_tokens / 10))
            ;;
        *)
            # Default: conservative estimate
            output_tokens=$((input_tokens / 2))
            ;;
    esac

    # Calculate estimated cost
    local estimated_cost
    estimated_cost=$(calculate_cost "$provider" "$model" "$input_tokens" "$output_tokens")

    # Get historical costs for comparison (if available)
    local workspace logs_dir usage_log
    workspace="$(get_workspace)"
    logs_dir="$workspace/logs"
    usage_log="$logs_dir/usage.jsonl"

    local historical_avg=""
    if [[ -f "$usage_log" ]] && command -v jq &>/dev/null; then
        # Get average cost from last 5 similar operations
        historical_avg=$(jq -s --arg prov "$provider" \
            'map(select(.provider == $prov)) | .[-5:] | map(.cost) | add / length' \
            "$usage_log" 2>/dev/null || echo "")
    fi

    # Display cost estimate
    echo ""
    echo "${BOLD}${BLUE}💰 Preflight Cost Estimate${RESET}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "  Provider:        $provider"
    echo "  Model:           $model"
    echo "  Operation:       $operation_type"
    echo "  Input tokens:    ~$input_tokens"
    echo "  Output tokens:   ~$output_tokens (estimated)"
    echo "  Estimated cost:  \$${estimated_cost} USD"

    if [[ -n "$historical_avg" && "$historical_avg" != "null" ]]; then
        # Format historical average
        historical_avg=$(awk "BEGIN {printf \"%.6f\", $historical_avg}")
        echo "  Historical avg:  \$${historical_avg} USD (last 5 ops)"

        # Show comparison
        local diff
        diff=$(awk "BEGIN {printf \"%.6f\", $estimated_cost - $historical_avg}")
        if (( $(awk "BEGIN {print ($estimated_cost > $historical_avg)}") )); then
            echo "  Comparison:      ${RED}+\$${diff} higher${RESET}"
        else
            diff=$(awk "BEGIN {printf \"%.6f\", $historical_avg - $estimated_cost}")
            echo "  Comparison:      ${GREEN}-\$${diff} lower${RESET}"
        fi
    fi

    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""

    # Check if cost estimation is enabled
    if [[ "$(config_get preferences.confirm_before_generate)" != "true" ]]; then
        return 0
    fi

    # Ask for confirmation
    if ! ui_confirm "Proceed with this operation?" "yes"; then
        msg "Operation cancelled"
        return 1
    fi

    return 0
}

