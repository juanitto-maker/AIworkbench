# Improve last output
cmd_improve() {
    local suggestion="$*"

    if [[ -z "$suggestion" ]]; then
        suggestion=$(ui_input "What improvements do you want?")
        [[ -z "$suggestion" ]] && return 0
    fi

    # Find last output
    local workspace output_dir
    workspace="$(get_workspace)"
    output_dir="$workspace/outputs"

    local latest
    latest=$(find "$output_dir" -name "*.md" -type f ! -name "*.feedback.md" 2>/dev/null | sort -r | head -1)

    if [[ -z "$latest" ]]; then
        err "No previous output found to improve"
        return 1
    fi

    msg "Improving: $(basename "$latest")"
    echo ""

    # Read last output
    local content
    content=$(cat "$latest")

    # Create improvement prompt
    local prompt="Improve the following based on this feedback: $suggestion

=== ORIGINAL CONTENT ===
$content

=== IMPROVEMENT REQUEST ===
$suggestion

Please provide an improved version incorporating the feedback."

    # Generate improvement
    local provider model
    provider="$(config_get model_provider)"
    model="$(config_get model_name)"

    msg "Generating improvements with $provider..."
    echo ""

    local improved
    improved=$(call_api "$prompt" "$provider" "$model")

    # Save improved version
    local improved_file="${latest%.md}_improved_$(date +%s).md"
    echo "$improved" > "$improved_file"

    success "Improved version saved to: $improved_file"

    # Show preview
    echo ""
    echo "${CYAN}${BOLD}Preview:${RESET}"
    echo "$improved" | head -20

    # Track usage
    track_usage "$provider" "$model" "$prompt" "$improved"
}

# Browse and use templates
cmd_templates() {
    local workspace templates_dir
    workspace="$(get_workspace)"
    templates_dir="$workspace/templates"

    # Create templates directory if it doesn't exist
    ensure_dir "$templates_dir"

    # Create default templates if none exist
    if [[ -z "$(ls -A "$templates_dir" 2>/dev/null)" ]]; then
        create_default_templates "$templates_dir"
    fi

    # List templates
    local templates
    templates=($(find "$templates_dir" -name "*.md" -type f -exec basename {} .md \; 2>/dev/null | sort))

    if [[ ${#templates[@]} -eq 0 ]]; then
        info "No templates found. Creating defaults..."
        create_default_templates "$templates_dir"
        templates=($(find "$templates_dir" -name "*.md" -type f -exec basename {} .md \; 2>/dev/null | sort))
    fi

    # Choose template
    local template
    template=$(ui_choose "Select Template" "${templates[@]}" "Cancel")

    [[ "$template" == "Cancel" || -z "$template" ]] && return 0

    # Load template
    local template_file="$templates_dir/${template}.md"
    local template_content
    template_content=$(cat "$template_file")

    # Show template
    echo ""
    ui_header "Template: $template"
    echo "$template_content"
    echo ""

    if ui_confirm "Use this template?" "yes"; then
        cmd_quick "$template_content"
    fi
}

