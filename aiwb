# Repo context command
cmd_repo() {
    local subcmd="${1:-status}"

    case "$subcmd" in
        status|"")
            if is_repo_mode; then
                ui_header "Repository Context"
                echo "Repository: ${AIWB_REPO_NAME}"
                echo "Path:       ${AIWB_REPO_PATH}"
                echo "Branch:     ${AIWB_REPO_BRANCH}"
                echo "Remote:     ${AIWB_REPO_REMOTE:-none}"
                echo ""
                # Show git status
                if have git; then
                    echo "Status:"
                    git -C "$AIWB_REPO_PATH" status --short 2>/dev/null | head -10
                fi
            else
                info "No repository context active"
                echo ""
                echo "To enable repo mode:"
                echo "  1. Navigate to a git repository: cd /path/to/repo"
                echo "  2. Start AIWB: aiwb"
                echo ""
                echo "Or clone a repo: aiwb github clone owner/repo"
            fi
            ;;
        none|disable|off)
            AIWB_REPO_ENABLED=false
            AIWB_REPO_PATH=""
            AIWB_REPO_NAME=""
            success "Repository context disabled"
            ;;
        refresh|detect)
            detect_repo
            if is_repo_mode; then
                success "Detected repo: $AIWB_REPO_NAME ($AIWB_REPO_BRANCH)"
            else
                info "No git repository found in current directory"
            fi
            ;;
        *)
            echo "Usage: /repo [status|none|refresh]"
            echo ""
            echo "Commands:"
            echo "  status   Show current repo context (default)"
            echo "  none     Disable repo mode"
            echo "  refresh  Re-detect repository"
            ;;
    esac
}

# ============================================================================
# MAIN
# ============================================================================

main() {
    # Parse global flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --debug)
                export AIWB_DEBUG=1
                shift
                ;;
            --version|-v)
                echo "AIWB v3.0.0"
                exit 0
                ;;
            --help|-h)
                cmd_help
                exit 0
                ;;
            --provider)
                config_set model_provider "$2"
                shift 2
                ;;
            --model)
                config_set model_name "$2"
                shift 2
                ;;
            *)
                break
                ;;
        esac
    done

    # Initialize
    initialize

    # Route command
    local cmd="${1:-chat}"
    shift || true

    debug "Routing to command: $cmd"

    case "$cmd" in
        chat|c)
            cmd_chat "$@"
            ;;
        quick|q)
            cmd_quick "$@"
            ;;
        wizard|wiz)
            cmd_wizard "$@"
            ;;
        make|m)
            cmd_make "$@"
            ;;
        improve|imp)
            cmd_improve "$@"
            ;;
        templates|tmpl)
            cmd_templates "$@"
            ;;
        generate|gen|g)
            cmd_generate "$@"
            ;;
        estimate|est|e)
            cmd_estimate "$@"
            ;;
        verify|review)
            cmd_verify "$@"
            ;;
        refine|loop)
            cmd_refine "$@"
            ;;
        keys|key)
            cmd_keys "$@"
            ;;
        models|settings|config)
            cmd_models "$@"
            ;;
        status|stat)
            ui_show_status
            ;;
        history|hist)
            cmd_history "$@"
            ;;
        costs|cost)
            cmd_costs "$@"
            ;;
        doctor|check)
            cmd_doctor "$@"
            ;;
        security-audit|audit)
            security_audit "$@"
            ;;
        scanrepo|scan)
            cmd_scanrepo "$@"
            ;;
        smartscan|smart)
            cmd_smartscan "$@"
            ;;
        github|gh)
            cmd_github "$@"
            ;;
        help|--help|-h)
            cmd_help
            ;;        
              *)
            # If no command is found, default to chat
            cmd_chat "$@"
            ;;




    esac
}

# Run main
main "$@"
