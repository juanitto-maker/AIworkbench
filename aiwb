# GitHub command handler
cmd_github() {
    local subcmd="${1:-}"
    shift || true

    case "$subcmd" in
        ""|menu)
            github_menu
            ;;
        status|stat)
            github_status
            ;;
        clone)
            github_clone "$@"
            ;;
        commit)
            github_commit "$@"
            ;;
        push)
            github_push "$@"
            ;;
        pull)
            github_pull "$@"
            ;;
        fetch)
            github_fetch "$@"
            ;;
        sync)
            github_sync "$@"
            ;;
        add|stage)
            github_add "$@"
            ;;
        branch|br)
            local branch_cmd="${1:-list}"
            shift || true
            case "$branch_cmd" in
                list)   github_branches "${1:-false}" ;;
                create) github_branch_create "$@" ;;
                switch) github_branch_switch "$@" ;;
                delete) github_branch_delete "$@" ;;
                *)      github_branches ;;
            esac
            ;;
        issue|issues)
            local issue_cmd="${1:-list}"
            shift || true
            case "$issue_cmd" in
                list)    github_issues_list "$@" ;;
                view)    github_issue_view "" "$@" ;;
                create)  github_issue_create "" "$@" ;;
                close)   github_issue_close "" "$@" ;;
                reopen)  github_issue_reopen "" "$@" ;;
                comment) github_issue_comment "" "$@" ;;
                *)       github_issues_list ;;
            esac
            ;;
        pr|prs)
            local pr_cmd="${1:-list}"
            shift || true
            case "$pr_cmd" in
                list)   github_pr_list "$@" ;;
                view)   github_pr_view "" "$@" ;;
                create) github_pr_create "" "$@" ;;
                merge)  github_pr_merge "" "$@" ;;
                close)  github_pr_close "" "$@" ;;
                files)  github_pr_files "" "$@" ;;
                *)      github_pr_list ;;
            esac
            ;;
        workflow|workflows|ci)
            local wf_cmd="${1:-list}"
            shift || true
            case "$wf_cmd" in
                list)  github_workflows_list "$@" ;;
                view)  github_workflow_view "" "$@" ;;
                rerun) github_workflow_rerun "" "$@" ;;
                *)     github_workflows_list ;;
            esac
            ;;
        auth|login)
            github_auth_setup
            ;;
        whoami|me)
            github_whoami
            ;;
        repo|info)
            github_repo_info "$@"
            ;;
        fork)
            github_fork "$@"
            ;;
        help|--help|-h)
            cmd_github_help
            ;;
        *)
            err "Unknown GitHub command: $subcmd"
            cmd_github_help
            return 1
            ;;
    esac
}

