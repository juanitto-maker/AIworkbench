# Context management - interactive menu
cmd_context() {
    while true; do
        local context_count=${#MODE_UPLOADS[@]}

        # Also check persistent context
        local persistent_count=0
        local has_scan=false
        if type context_state_exists &>/dev/null && context_state_exists; then
            # Count only manual files, excluding scan output files
            persistent_count=$(context_state_get "context_files" 2>/dev/null | jq '[.[] | select(.type == "manual")] | length' 2>/dev/null || echo 0)
            local scan_file
            scan_file=$(context_state_get "last_scan.output_file" 2>/dev/null)
            [[ -n "$scan_file" && -f "$scan_file" ]] && has_scan=true
        fi

        local total_context=$((context_count + persistent_count))
        local context_display="$context_count in-memory"
        if [[ $persistent_count -gt 0 ]] || [[ "$has_scan" == "true" ]]; then
            context_display="$context_count in-memory, $persistent_count saved"
            if [[ "$has_scan" == "true" ]]; then
                context_display="$context_display + scan"
            fi
        fi

        local choice
        choice=$(ui_choose "Context Manager ($context_display)" \
            "Add files/directories" \
            "List current context" \
            "Show persistent context" \
            "Load persistent context" \
            "Remove from context" \
            "Clear all context" \
            "Back")

        case "$choice" in
            "Add files/directories")
                menu_uploads
                ;;
            "List current context")
                echo ""
                echo "In-Memory Context (MODE_UPLOADS):"
                if [[ ${#MODE_UPLOADS[@]} -gt 0 ]]; then
                    for item in "${MODE_UPLOADS[@]}"; do
                        if [[ -f "$item" ]]; then
                            local size=$(stat -f%z "$item" 2>/dev/null || stat -c%s "$item" 2>/dev/null || echo 0)
                            local size_kb=$((size / 1024))
                            if is_image_file "$item"; then
                                echo "  - [IMAGE] $item (${size_kb} KB)"
                            else
                                echo "  - [FILE] $item (${size_kb} KB)"
                            fi
                        elif [[ -d "$item" ]]; then
                            local count=$(find "$item" -type f 2>/dev/null | wc -l | tr -d ' ')
                            echo "  - [DIR] $item/ ($count files)"
                        fi
                    done
                else
                    echo "  (no in-memory context files)"
                fi
                echo ""
                ui_confirm "Press enter to continue..."
                ;;
            "Show persistent context")
                echo ""
                if type context_state_show &>/dev/null; then
                    context_state_show
                else
                    warn "Context persistence not available"
                fi
                echo ""
                ui_confirm "Press enter to continue..."
                ;;
            "Load persistent context")
                if type context_state_load_into_mode &>/dev/null; then
                    echo ""
                    context_state_load_into_mode
                    echo ""
                    ui_confirm "Press enter to continue..."
                else
                    warn "Context persistence not available"
                fi
                ;;
            "Remove from context")
                if [[ ${#MODE_UPLOADS[@]} -eq 0 ]]; then
                    warn "No in-memory context files to remove"
                else
                    # Build list of items for removal
                    local items=()
                    for item in "${MODE_UPLOADS[@]}"; do
                        items+=("$item")
                    done
                    items+=("Back")

                    local to_remove
                    to_remove=$(ui_choose "Select file to remove" "${items[@]}")

                    if [[ -n "$to_remove" ]] && [[ "$to_remove" != "Back" ]]; then
                        local new_uploads=()
                        for upload in "${MODE_UPLOADS[@]}"; do
                            if [[ "$upload" != "$to_remove" ]]; then
                                new_uploads+=("$upload")
                            fi
                        done
                        MODE_UPLOADS=("${new_uploads[@]}")
                        success "Removed from in-memory context: $to_remove"
                    fi
                fi
                ;;
            "Clear all context")
                if [[ ${#MODE_UPLOADS[@]} -gt 0 ]] || [[ $persistent_count -gt 0 ]]; then
                    local choices=()
                    [[ ${#MODE_UPLOADS[@]} -gt 0 ]] && choices+=("Clear in-memory context only")
                    if type context_state_exists &>/dev/null && context_state_exists; then
                        choices+=("Clear persistent context only")
                        choices+=("Clear ALL (recommended)")
                    fi
                    choices+=("Cancel")

                    local clear_choice
                    clear_choice=$(ui_choose "What to clear?" "${choices[@]}")

                    case "$clear_choice" in
                        "Clear in-memory context only")
                            clear_all_mode_state
                            success "In-memory context and mode state cleared"
                            warn "Note: Persistent context still exists. Use 'Clear ALL' for complete clearing."
                            ;;
                        "Clear persistent context only")
                            if type context_state_clear &>/dev/null; then
                                context_state_clear
                            fi
                            warn "Note: In-memory context still loaded. Use 'Clear ALL' for complete clearing."
                            ;;
                        "Clear ALL (recommended)")
                            # Clear persistent state
                            if type context_state_clear &>/dev/null && context_state_exists; then
                                context_state_clear
                            fi
                            # Clear all in-memory state
                            clear_all_mode_state
                            success "All context cleared successfully (persistent + in-memory)"
                            info "You can now start fresh or load new context"
                            ;;
                    esac
                else
                    info "Context is already empty"
                fi
                ;;
            "Back"|"")
                break
                ;;
        esac
    done
}

