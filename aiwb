# Main interactive chat interface
cmd_chat() {
    clear 2>/dev/null || true  # Don't fail if TERM not set
    ui_header "AIWB Interactive Chat"

    # Show status
    ui_show_status
    echo ""

    # Check if keys are set
    local provider
    provider="$(config_get model_provider)"

    if ! has_api_key "$provider"; then
        ui_info_box "No API key found for $provider.
Please set up your API keys to continue." "warning"
        echo ""

        if ui_confirm "Set up API keys now?"; then
            cmd_keys
        else
            exit 0
        fi
    fi

    # Start chat loop
    chat_loop
}

# Chat loop
chat_loop() {
    local workspace logs_dir
    workspace="$(get_workspace)"
    logs_dir="$workspace/logs"
    local chat_log="$logs_dir/chat_$(date +%Y%m%d_%H%M%S).log"

    msg "Chat started. Type /help for commands or /exit to quit."
    echo ""

    while true; do
        local input

        # Get input
        if $GUM_AVAILABLE; then
            input=$(gum input --placeholder "Message or /command..." --width 80) || continue
        else
            # Try to read from /dev/tty first, then stdin
            echo -n "> "
            if [[ -c /dev/tty ]] && [[ -r /dev/tty ]]; then
                read -r input </dev/tty || break
            else
                read -r input || break
            fi
        fi

        [[ -z "$input" ]] && continue

        # Log input
        echo "[$(date -Iseconds)] USER: $input" >> "$chat_log"

        # Handle commands
        if [[ "$input" == /* ]]; then
            handle_slash_command "$input"
        else
            # Send to AI
            handle_chat_message "$input" | tee -a "$chat_log"
        fi

        echo ""
    done
}

# Handle slash commands
handle_slash_command() {
    local cmd="$1"

    case "$cmd" in
        /help)
            show_chat_help
            ;;
        /keys)
            cmd_keys
            ;;
        /settings)
            cmd_settings
            ;;
        /status)
            ui_show_status
            ;;
        /estimate)
            cmd_estimate
            ;;
        /generate)
            cmd_generate
            ;;
        /verify)
            cmd_verify
            ;;
        /refine)
            cmd_refine
            ;;
        /history)
            cmd_history
            ;;
        /costs)
            cmd_costs
            ;;
        /clear)
            clear 2>/dev/null || true
            ui_header "AIWB Interactive Chat"
            ;;
        /exit|/quit)
            msg "Goodbye!"
            exit 0
            ;;
        *)
            warn "Unknown command: $cmd"
            echo "Type /help for available commands"
            ;;
    esac
}

# Show chat help
show_chat_help() {
    cat <<'EOF'
CHAT COMMANDS:
  /help       Show this help
  /keys       Manage API keys
  /settings   Configure provider/model
  /status     Show current status
  /estimate   Estimate cost for current task
  /generate   Generate content for current task
  /verify     Verify/review generated content
  /refine     Auto-refine with Generator-Verifier loop
  /history    Show chat history
  /costs      Show cost breakdown
  /clear      Clear screen
  /exit       Quit

Just type normally to chat with the AI!
EOF
}

# Handle chat message
handle_chat_message() {
    local message="$1"
    local provider model
    provider="$(config_get model_provider)"
    model="$(config_get model_name)"

    # Show typing indicator
    if $GUM_AVAILABLE; then
        ui_spinner "Thinking..." &
        local spinner_pid=$!
        trap "kill $spinner_pid 2>/dev/null" RETURN
    fi

    # Call API
    local response
    response=$(call_api "$message" "$provider" "$model" 2>/dev/null)
    local exit_code=$?

    # Kill spinner
    if $GUM_AVAILABLE; then
        kill $spinner_pid 2>/dev/null || true
        wait $spinner_pid 2>/dev/null || true
        echo -ne "\r\033[K"  # Clear line
    fi

    if [[ $exit_code -ne 0 ]]; then
        err "Failed to get response"
        return 1
    fi

    # Display response
    echo ""
    if $GUM_AVAILABLE; then
        echo "$response" | gum style --border rounded --padding "1 2" --width 80
    else
        echo "${CYAN}┌─ Response ──────────────────────────────────────────┐${RESET}"
        echo "$response" | fold -s -w 76 | sed 's/^/│ /' | sed "s/$/$(printf ' %.0s' {1..76})/" | cut -c1-78 | sed "s/$/│/"
        echo "${CYAN}└─────────────────────────────────────────────────────┘${RESET}"
    fi
    echo ""

    # Track cost
    track_usage "$provider" "$model" "$message" "$response"
}

# Track API usage and costs
track_usage() {
    local provider="$1"
    local model="$2"
    local input="$3"
    local output="$4"

    local input_tokens output_tokens cost
    input_tokens=$(estimate_tokens "$input")
    output_tokens=$(estimate_tokens "$output")
    cost=$(calculate_cost "$provider" "$model" "$input_tokens" "$output_tokens")

    # Save to usage log
    local workspace logs_dir
    workspace="$(get_workspace)"
    logs_dir="$workspace/logs"
    local usage_log="$logs_dir/usage.jsonl"

    local entry
    entry=$(jq -n \
        --arg provider "$provider" \
        --arg model "$model" \
        --arg in_tokens "$input_tokens" \
        --arg out_tokens "$output_tokens" \
        --arg cost "$cost" \
        --arg timestamp "$(date -Iseconds)" \
        '{provider: $provider, model: $model, input_tokens: ($in_tokens | tonumber), output_tokens: ($out_tokens | tonumber), cost: ($cost | tonumber), timestamp: $timestamp}')

    echo "$entry" >> "$usage_log"

    # Show cost if enabled
    if [[ "$(config_get preferences.show_costs)" == "true" ]]; then
        debug "Cost: \$${cost} USD (${input_tokens} in + ${output_tokens} out tokens)"
    fi
}

