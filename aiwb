# Quick one-shot generation with auto-verify
cmd_quick() {
    local description="$*"

    # If no description provided, prompt for it
    if [[ -z "$description" ]]; then
        description=$(ui_input "What do you want to create?")
        [[ -z "$description" ]] && return 0
    fi

    ui_header "Quick Generation"
    msg "Creating: $description"
    echo ""

    # Create temporary task
    local task_name="quick_$(date +%s)"
    local workspace tasks_dir
    workspace="$(get_workspace)"
    tasks_dir="$workspace/tasks"
    ensure_dir "$tasks_dir"

    local task_file="$tasks_dir/${task_name}.prompt.md"
    echo "$description" > "$task_file"

    # Set as current task
    config_set current_task "$task_name"

    # Check if should auto-verify
    local auto_verify="true"
    if [[ "$(config_get preferences.confirm_before_generate)" == "true" ]]; then
        if ! ui_confirm "Auto-verify with a different model?" "yes"; then
            auto_verify="false"
        fi
    fi

    # Generate
    cmd_generate "$task_name"

    # Auto-verify if enabled
    if [[ "$auto_verify" == "true" ]]; then
        echo ""
        msg "Auto-verifying with cross-provider review..."
        cmd_verify "$task_name"
    fi

    # Cleanup temporary task
    rm -f "$task_file"

    echo ""
    success "Done! Check outputs with: ./aiwb history"
}

# Interactive wizard workflow
cmd_wizard() {
