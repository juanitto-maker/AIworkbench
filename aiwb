# Estimate task (helper)
estimate_task() {
    local task="$1"
    local prompt="$2"

    local provider model
    provider="$(config_get model_provider)"
    model="$(config_get model_name)"

    local input_tokens
    input_tokens=$(estimate_tokens "$prompt")

    # Estimate output tokens (rough: 2x input for generation tasks)
    local output_tokens=$((input_tokens * 2))

    # Calculate costs for different tiers
    local tier_mult
    declare -A tiers=(
        ["Basic"]="0.65"
        ["Medium"]="1.00"
        ["Best"]="1.60"
    )

    ui_header "Cost Estimate for: $task"

    echo "Provider: $provider"
    echo "Model:    $model"
    echo ""
    echo "Input tokens:  $input_tokens"
    echo ""

    if $GUM_AVAILABLE; then
        local rows=()
        for tier in Basic Medium Best; do
            mult="${tiers[$tier]}"
            est_out=$(awk "BEGIN {printf \"%.0f\", $output_tokens * $mult}")
            cost=$(calculate_cost "$provider" "$model" "$input_tokens" "$est_out")
            rows+=("${tier}\t${est_out}\t\$${cost}")
        done

        {
            echo "Tier\tOutput Tokens\tCost (USD)"
            printf '%s\n' "${rows[@]}"
        } | column -t -s $'\t'
    else
        printf "%-10s %-15s %s\n" "Tier" "Output Tokens" "Cost (USD)"
        echo "───────────────────────────────────────"
        for tier in Basic Medium Best; do
            mult="${tiers[$tier]}"
            est_out=$(awk "BEGIN {printf \"%.0f\", $output_tokens * $mult}")
            cost=$(calculate_cost "$provider" "$model" "$input_tokens" "$est_out")
            printf "%-10s %-15s \$%s\n" "$tier" "$est_out" "$cost"
        done
    fi
    echo ""
}

