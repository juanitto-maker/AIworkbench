        tech=$(ui_choose "Choose technology/language:" \
            "Bash/Shell" \
            "Python" \
            "JavaScript/Node.js" \
            "Go" \
            "Rust" \
            "Other/Mixed" \
            "Skip")
        [[ "$tech" == "Skip" ]] && tech=""
    fi

    # Step 4: Special requirements
    echo ""
    local requirements
    requirements=$(ui_input "Any special requirements? (optional)" "" "e.g., security, performance, compatibility")

    # Step 5: Build the prompt
    local full_prompt="$description"
    [[ -n "$tech" && "$tech" != "Skip" ]] && full_prompt="$full_prompt

Technology: $tech"
    [[ -n "$requirements" ]] && full_prompt="$full_prompt

Requirements:
$requirements"

    # Step 6: Show preview and confirm
    echo ""
    ui_header "Preview"
    echo "$full_prompt"
    echo ""

    if ! ui_confirm "Proceed with generation?" "yes"; then
        msg "Cancelled"
        return 0
    fi

    # Step 7: Choose workflow
    echo ""
    local workflow
    workflow=$(ui_choose "Choose workflow:" \
        "Quick (generate + verify)" \
        "Generate only" \
        "Full refinement loop (3 iterations)")

    # Execute
    echo ""
    case "$workflow" in
        "Quick"*)
            cmd_quick "$full_prompt"
            ;;
        "Generate only")
            local task_name="wizard_$(date +%s)"
            local workspace tasks_dir
            workspace="$(get_workspace)"
            tasks_dir="$workspace/tasks"
            ensure_dir "$tasks_dir"
            echo "$full_prompt" > "$tasks_dir/${task_name}.prompt.md"
            config_set current_task "$task_name"
            cmd_generate "$task_name"
            rm -f "$tasks_dir/${task_name}.prompt.md"
            ;;
        "Full refinement"*)
            local task_name="wizard_$(date +%s)"
            local workspace tasks_dir
            workspace="$(get_workspace)"
            tasks_dir="$workspace/tasks"
            ensure_dir "$tasks_dir"
            echo "$full_prompt" > "$tasks_dir/${task_name}.prompt.md"
            config_set current_task "$task_name"
            cmd_refine "$task_name" 3
            rm -f "$tasks_dir/${task_name}.prompt.md"
            ;;
    esac
}

