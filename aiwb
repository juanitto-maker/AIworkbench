# Overall status overview
cmd_status_overview() {
    ui_header "AIWB Status Overview"

    # Current configuration
    echo "Configuration:"
    echo "  Provider: $(config_get model_provider)"
    echo "  Model: $(config_get model_name)"
    echo "  Workspace: $(get_workspace)"
    echo ""

    # Mode states
    echo "Mode States:"
    echo "  Make - Model: ${MODE_MODEL_PROVIDER:-default} ${MODE_MODEL_NAME:-default}"
    echo "  Tweak - Model: ${MODE_MODEL_PROVIDER:-default} ${MODE_MODEL_NAME:-default}"
    echo "  Debug - Model: ${MODE_MODEL_PROVIDER:-default} ${MODE_MODEL_NAME:-default}"
    echo ""

    # Context
    echo "Global Context:"
    if [[ ${#MODE_UPLOADS[@]} -gt 0 ]]; then
        for item in "${MODE_UPLOADS[@]}"; do
            echo "  - $item"
        done
    else
        echo "  (no files uploaded)"
    fi
    echo ""

    # Costs
    local workspace logs_dir usage_log
    workspace="$(get_workspace)"
    logs_dir="$workspace/logs"
    usage_log="$logs_dir/usage.jsonl"

    if [[ -f "$usage_log" ]]; then
        echo "Costs (All Time):"
        local total
        total=$(jq -s 'map(.cost) | add' "$usage_log" 2>/dev/null || echo "0")
        echo "  Total spent: \$${total} USD"

        echo ""
        echo "  By Provider:"
        jq -s 'group_by(.provider) | map({provider: .[0].provider, cost: (map(.cost) | add)}) | .[]' "$usage_log" 2>/dev/null | \
            jq -r '"    \(.provider): $\(.cost)"'
    else
        echo "Costs:"
        echo "  No usage data yet"
    fi
    echo ""

    # Recent activity
    echo "Recent Activity:"
    if [[ -d "$workspace/outputs" ]]; then
        local recent
        recent=$(find "$workspace/outputs" -name "*.md" ! -name "*.feedback.md" -type f 2>/dev/null | sort -r | head -3)
        if [[ -n "$recent" ]]; then
            echo "$recent" | while read -r file; do
                local basename=$(basename "$file")
                local timestamp=$(stat -f%Sm -t "%Y-%m-%d %H:%M" "$file" 2>/dev/null || stat -c%y "$file" 2>/dev/null | cut -d'.' -f1)
                echo "  - $basename ($timestamp)"
            done
        else
            echo "  (no recent outputs)"
        fi
    else
        echo "  (no outputs yet)"
    fi
    echo ""
}

# Context management
cmd_context() {
    local subcmd="$1"
    shift || true

    case "$subcmd" in
        add)
            mode_uploads "$@"
            ;;
        list)
            echo "Context Files:"
            if [[ ${#MODE_UPLOADS[@]} -gt 0 ]]; then
                for item in "${MODE_UPLOADS[@]}"; do
                    if [[ -f "$item" ]]; then
                        local size=$(stat -f%z "$item" 2>/dev/null || stat -c%s "$item" 2>/dev/null || echo 0)
                        local size_kb=$((size / 1024))
                        echo "  - $item (${size_kb} KB)"
                    elif [[ -d "$item" ]]; then
                        local count=$(find "$item" -type f 2>/dev/null | wc -l | tr -d ' ')
                        echo "  - $item/ ($count files)"
                    fi
                done
            else
                echo "  (no context files)"
            fi
            ;;
        remove)
            if [[ -z "$1" ]]; then
                warn "Usage: /context remove <file|dir>"
                return 1
            fi
            local item="$1"
            local new_uploads=()
            local found=false
            for upload in "${MODE_UPLOADS[@]}"; do
                if [[ "$upload" != "$item" ]]; then
                    new_uploads+=("$upload")
                else
                    found=true
                fi
            done
            if $found; then
                MODE_UPLOADS=("${new_uploads[@]}")
                success "Removed from context: $item"
            else
                warn "Not found in context: $item"
            fi
            ;;
        clear)
            MODE_UPLOADS=()
            success "Context cleared"
            ;;
        *)
            cat <<'EOF'
Context Management:
  /context add <files/dirs>    Add files to context
  /context list                List context files
  /context remove <item>       Remove from context
  /context clear               Clear all context
EOF
            ;;
    esac
}

