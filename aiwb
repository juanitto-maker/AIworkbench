    [[ "$project_type" == "Cancel" || -z "$project_type" ]] && return 0

    # Step 2: Get description
    echo ""
    local description
    description=$(ui_input "Brief description of your project:")
    [[ -z "$description" ]] && return 0

    # Step 3: Choose language/technology (if applicable)
    local tech=""
    if [[ "$project_type" != "Just chat/brainstorm" && "$project_type" != "Documentation" ]]; then
