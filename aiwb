# Preferences settings
settings_preferences() {
    while true; do
        local auto_estimate confirm_gen show_costs
        auto_estimate="$(config_get preferences.auto_estimate)"
        confirm_gen="$(config_get preferences.confirm_before_generate)"
        show_costs="$(config_get preferences.show_costs)"

        local choice
        choice=$(ui_choose "Preferences" \
            "Auto-estimate: $auto_estimate" \
            "Confirm before generate: $confirm_gen" \
            "Show costs: $show_costs" \
            "Back")

        case "$choice" in
            "Auto-estimate:"*)
                [[ "$auto_estimate" == "true" ]] && auto_estimate="false" || auto_estimate="true"
                config_set preferences.auto_estimate "$auto_estimate"
                ;;
            "Confirm before generate:"*)
                [[ "$confirm_gen" == "true" ]] && confirm_gen="false" || confirm_gen="true"
                config_set preferences.confirm_before_generate "$confirm_gen"
