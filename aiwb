# Build repository context automatically

build_repo_context() {
    local mode="${1:-selective}"
    local max_file_size=50000
    local context=""
    local file_count=0

    msg "Building $mode context for $(basename "$(pwd)")..."

    # Helper function to check if file is binary by extension
    is_binary_extension() {
        local file="$1"
        case "$file" in
            *.jpg|*.jpeg|*.png|*.gif|*.ico|*.svg|*.webp) return 0 ;;
            *.pdf|*.zip|*.tar|*.gz|*.bz2|*.xz|*.7z) return 0 ;;
            *.exe|*.dll|*.so|*.dylib|*.o|*.a) return 0 ;;
            *.mp4|*.mp3|*.avi|*.mov|*.wav) return 0 ;;
            *.woff|*.woff2|*.ttf|*.eot|*.otf) return 0 ;;
            *.class|*.jar|*.war|*.pyc|*.pyo) return 0 ;;
            *) return 1 ;;
        esac
    }

    if [[ "$mode" == "full" ]]; then
        # Full scan: all text files except in excluded dirs
        msg "Deep scan: reading all source files..."

        # Use process substitution to avoid subshell variable issues
        while IFS= read -r file; do
            # Skip binary files by extension
            if is_binary_extension "$file"; then
                continue
            fi

            # Try to read file content
            local file_content
            file_content=$(head -c "$max_file_size" "$file" 2>/dev/null || true)
            if [[ -n "$file_content" ]]; then
                context+=$'\n'"--- FILE: $file ---"$'\n'
                context+="$file_content"$'\n'
                ((file_count++))
            fi
        done < <(find . -type f \
            -not -path '*/.git/*' \
            -not -path '*/node_modules/*' \
            -not -path '*/dist/*' \
            -not -path '*/build/*' \
            -not -path '*/__pycache__/*' \
            -not -path '*/.next/*' \
            -not -path '*/vendor/*' \
            -not -path '*/target/*' \
            -not -path '*/.venv/*' \
            -not -path '*/venv/*' \
            2>/dev/null)

    else
        # Selective: key files only
        msg "Smart scan: reading key files..."

        # Config files
        for pattern in "package.json" "tsconfig.json" "vite.config.*" "*.config.js" "*.config.ts" "Cargo.toml" "go.mod" "requirements.txt" ".env.example"; do
            while IFS= read -r file; do
                local file_content
                file_content=$(head -c "$max_file_size" "$file" 2>/dev/null || true)
                if [[ -n "$file_content" ]]; then
                    context+=$'\n'"--- FILE: $file ---"$'\n'
                    context+="$file_content"$'\n'
                    ((file_count++))
                fi
            done < <(find . -maxdepth 2 -type f -name "$pattern" \
                -not -path '*/.git/*' \
                -not -path '*/node_modules/*' \
                2>/dev/null)
        done

        # Documentation
        for pattern in "README*" "CHANGELOG*" "LICENSE*"; do
            while IFS= read -r file; do
                local file_content
                file_content=$(head -c "$max_file_size" "$file" 2>/dev/null || true)
                if [[ -n "$file_content" ]]; then
                    context+=$'\n'"--- FILE: $file ---"$'\n'
                    context+="$file_content"$'\n'
                    ((file_count++))
                fi
            done < <(find . -maxdepth 2 -type f -name "$pattern" \
                -not -path '*/.git/*' \
                2>/dev/null)
        done

        # Main source files - NO MORE file command!
        for pattern in "main.*" "index.*" "app.*" "App.*" "server.*" "__init__.py" "mod.rs"; do
            while IFS= read -r file; do
                # Skip binary extensions
                if is_binary_extension "$file"; then
                    continue
                fi

                local file_content
                file_content=$(head -c "$max_file_size" "$file" 2>/dev/null || true)
                if [[ -n "$file_content" ]]; then
                    context+=$'\n'"--- FILE: $file ---"$'\n'
                    context+="$file_content"$'\n'
                    ((file_count++))
                fi
            done < <(find . -maxdepth 3 -type f -name "$pattern" \
                -not -path '*/.git/*' \
                -not -path '*/node_modules/*' \
                -not -path '*/dist/*' \
                2>/dev/null)
        done
    fi

    msg "Context built: $file_count files scanned"
    echo "$context"
}

