    workspace="$(get_workspace)"
    logs_dir="$workspace/logs"

    if [[ ! -d "$logs_dir" ]]; then
        info "No chat history found"
        return 0
    fi

    while true; do
        local log_count=$(ls -1 "$logs_dir"/chat_*.log 2>/dev/null | wc -l | tr -d ' ')

        local choice
        choice=$(ui_choose "Chat History ($log_count sessions)" \
            "View recent sessions" \
            "Search in history" \
            "Show statistics" \
            "Export all history" \
            "Clear old logs" \
            "Back")

        case "$choice" in
            "View recent sessions")
                if [[ $log_count -eq 0 ]]; then
                    warn "No chat sessions found"
                    continue
                fi

                # List sessions with timestamps
                local logs sessions
                logs=($(ls -t "$logs_dir"/chat_*.log 2>/dev/null))
                sessions=()

                for log in "${logs[@]}"; do
                    local basename=$(basename "$log")
                    local date_part=$(echo "$basename" | sed 's/chat_\(.*\)\.log/\1/')
                    local formatted_date=$(echo "$date_part" | sed 's/_/ /g' | sed 's/\([0-9]\{4\}\)\([0-9]\{2\}\)\([0-9]\{2\}\) \([0-9]\{2\}\)\([0-9]\{2\}\)\([0-9]\{2\}\)/\1-\2-\3 \4:\5:\6/')
                    local msg_count=$(grep -c "USER:" "$log" 2>/dev/null || echo 0)
                    sessions+=("$formatted_date ($msg_count messages)")
                done
                sessions+=("Back")

                local selected
                selected=$(ui_choose "Select Session" "${sessions[@]}")

                if [[ -n "$selected" ]] && [[ "$selected" != "Back" ]]; then
                    # Find the corresponding log file
                    local idx=0
                    for i in "${!sessions[@]}"; do
                        if [[ "${sessions[$i]}" == "$selected" ]]; then
                            idx=$i
                            break
                        fi
                    done

                    if [[ $idx -lt ${#logs[@]} ]]; then
                        clear 2>/dev/null || true
                        ui_header "Chat Session: $selected"
                        echo ""
                        cat "${logs[$idx]}"
                        echo ""
                        ui_confirm "Press enter to continue..."
                    fi
                fi
                ;;

            "Search in history")
                if [[ $log_count -eq 0 ]]; then
                    warn "No chat sessions to search"
                    continue
                fi

                local search_term
                search_term=$(ui_input "Search for:")
                if [[ -n "$search_term" ]]; then
                    echo ""
                    msg "Search results for: '$search_term'"
                    echo ""
                    grep -i -n --color=auto "$search_term" "$logs_dir"/chat_*.log 2>/dev/null || echo "No matches found"
                    echo ""
                    ui_confirm "Press enter to continue..."
                fi
                ;;

            "Show statistics")
                if [[ $log_count -eq 0 ]]; then
                    warn "No chat sessions found"
                    continue
                fi

                clear 2>/dev/null || true
                ui_header "Chat History Statistics"
                echo ""

                local total_messages=$(grep -c "USER:" "$logs_dir"/chat_*.log 2>/dev/null || echo 0)
                local total_ai_responses=$(grep -c "AI:" "$logs_dir"/chat_*.log 2>/dev/null || echo 0)
                local oldest_log=$(ls -t "$logs_dir"/chat_*.log 2>/dev/null | tail -1)
                local newest_log=$(ls -t "$logs_dir"/chat_*.log 2>/dev/null | head -1)

                echo "Total sessions: $log_count"
                echo "Total user messages: $total_messages"
                echo "Total AI responses: $total_ai_responses"

                if [[ -n "$oldest_log" ]]; then
                    local oldest_date=$(basename "$oldest_log" | sed 's/chat_\(.*\)\.log/\1/' | sed 's/_/ /g')
                    echo "Oldest session: $oldest_date"
                fi

                if [[ -n "$newest_log" ]]; then
                    local newest_date=$(basename "$newest_log" | sed 's/chat_\(.*\)\.log/\1/' | sed 's/_/ /g')
                    echo "Latest session: $newest_date"
                fi

                # Calculate total size
                local total_size=$(du -sh "$logs_dir" 2>/dev/null | cut -f1)
                echo "Total storage: $total_size"

                echo ""
                ui_confirm "Press enter to continue..."
                ;;

            "Export all history")
                if [[ $log_count -eq 0 ]]; then
                    warn "No chat sessions to export"
                    continue
                fi

                local export_file
                export_file=$(ui_input "Export to file:" "$HOME/aiwb_history_export.txt")
                if [[ -n "$export_file" ]]; then
                    cat "$logs_dir"/chat_*.log > "$export_file" 2>/dev/null
                    success "History exported to: $export_file"
                fi
                ;;

            "Clear old logs")
                if [[ $log_count -eq 0 ]]; then
                    info "No logs to clear"
                    continue
                fi

                local days
                days=$(ui_input "Delete logs older than (days):" "30")
                if [[ -n "$days" ]] && [[ "$days" =~ ^[0-9]+$ ]]; then
                    if ui_confirm "Delete logs older than $days days?" "no"; then
                        local deleted=0
                        find "$logs_dir" -name "chat_*.log" -type f -mtime +$days -exec rm {} \; -exec echo {} \; | while read -r; do
                            ((deleted++))
                        done
                        success "Deleted old chat logs"
                    fi
                fi
                ;;

            "Back"|"")
                break
                ;;
        esac
    done
}

# Show cost breakdown
cmd_costs() {
    local workspace logs_dir usage_log
    workspace="$(get_workspace)"
    logs_dir="$workspace/logs"
    usage_log="$logs_dir/usage.jsonl"

    if [[ ! -f "$usage_log" ]]; then
        info "No usage data found"
        return 0
    fi

    ui_header "Cost Breakdown"

    # Total costs
    local total
    total=$(jq -s 'map(.cost) | add' "$usage_log" 2>/dev/null || echo "0")
    echo "Total spent: \$${total} USD"
    echo ""

    # By provider
    echo "By Provider:"
    jq -s 'group_by(.provider) | map({provider: .[0].provider, cost: (map(.cost) | add)}) | .[]' "$usage_log" 2>/dev/null | \
        jq -r '"\(.provider)\t\(.cost)"' | column -t

    echo ""

    # By date
    echo "Recent activity:"
    jq -s 'sort_by(.timestamp) | reverse | limit(10; .[]) | "\(.timestamp | split("T")[0])\t\(.provider)\t\(.cost)"' "$usage_log" 2>/dev/null | column -t
}

# System health check
cmd_doctor() {
    ui_header "System Health Check"

    # Check dependencies
    echo "Dependencies:"
    for cmd in bash jq curl git gum fzf age; do
        if have "$cmd"; then
            success "✓ $cmd installed"
        else
            warn "○ $cmd not installed (optional)" 2>/dev/null || echo "○ $cmd not installed (optional)"
        fi
    done

    echo ""

    # Check API keys
    echo "API Keys:"
    for provider in gemini claude openai groq xai; do
        if has_api_key "$provider"; then
            success "✓ $provider key configured"
        else
            info "○ $provider key not configured"
        fi
    done

    # Check GitHub token
    echo ""
    echo "GitHub Integration:"
    if has_github_token; then
        success "✓ GitHub token configured"
    else
        info "○ GitHub token not configured (run: aiwb github auth)"
    fi

    echo ""

    # Check workspace
    local workspace
    workspace="$(get_workspace)"
    echo "Workspace: $workspace"
    if [[ -d "$workspace" ]]; then
        success "✓ Workspace exists"
    else
        warn "⚠ Workspace not found"
    fi

    echo ""

    # Platform info
    echo "Platform:"
    echo "  OS: $(get_platform)"
    echo "  Arch: $(uname -m)"
    echo "  Shell: $SHELL"

    echo ""
    success "Health check complete"
}

# GitHub command handler
cmd_github() {
    local subcmd="${1:-}"
    shift || true

    case "$subcmd" in
        ""|menu)
            github_menu
            ;;
        status|stat)
            github_status
            ;;
        clone)
            github_clone "$@"
            ;;
        commit)
            github_commit "$@"
            ;;
        push)
            github_push "$@"
            ;;
        pull)
            github_pull "$@"
            ;;
        fetch)
            github_fetch "$@"
            ;;
        add|stage)
            github_add "$@"
            ;;
        branch|br)
            local branch_cmd="${1:-list}"
            shift || true
            case "$branch_cmd" in
                list)   github_branches "${1:-false}" ;;
                create) github_branch_create "$@" ;;
                switch) github_branch_switch "$@" ;;
                delete) github_branch_delete "$@" ;;
                *)      github_branches ;;
            esac
            ;;
        issue|issues)
            local issue_cmd="${1:-list}"
            shift || true
            case "$issue_cmd" in
                list)    github_issues_list "$@" ;;
                view)    github_issue_view "" "$@" ;;
                create)  github_issue_create "" "$@" ;;
                close)   github_issue_close "" "$@" ;;
                reopen)  github_issue_reopen "" "$@" ;;
                comment) github_issue_comment "" "$@" ;;
                *)       github_issues_list ;;
            esac
            ;;
        pr|prs)
            local pr_cmd="${1:-list}"
            shift || true
            case "$pr_cmd" in
                list)   github_pr_list "$@" ;;
                view)   github_pr_view "" "$@" ;;
                create) github_pr_create "" "$@" ;;
                merge)  github_pr_merge "" "$@" ;;
                close)  github_pr_close "" "$@" ;;
                files)  github_pr_files "" "$@" ;;
                *)      github_pr_list ;;
            esac
            ;;
        workflow|workflows|ci)
            local wf_cmd="${1:-list}"
            shift || true
            case "$wf_cmd" in
                list)  github_workflows_list "$@" ;;
                view)  github_workflow_view "" "$@" ;;
                rerun) github_workflow_rerun "" "$@" ;;
                *)     github_workflows_list ;;
            esac
            ;;
        auth|login)
            github_auth_setup
            ;;
        whoami|me)
            github_whoami
            ;;
        repo|info)
            github_repo_info "$@"
            ;;
        fork)
            github_fork "$@"
            ;;
        help|--help|-h)
            cmd_github_help
            ;;
        *)
            err "Unknown GitHub command: $subcmd"
            cmd_github_help
            return 1
            ;;
    esac
}

