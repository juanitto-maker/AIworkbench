# Copy text to clipboard with auto-detection of clipboard tool
copy_to_clipboard() {
    local text="$1"
    local clipboard_cmd=""

    # Detect available clipboard command
    if have termux-clipboard-set; then
        # Termux
        clipboard_cmd="termux-clipboard-set"
    elif have xclip; then
        # Linux with X11
        clipboard_cmd="xclip -selection clipboard"
    elif have xsel; then
        # Linux alternative
        clipboard_cmd="xsel --clipboard --input"
    elif have pbcopy; then
        # macOS
        clipboard_cmd="pbcopy"
    elif have wl-copy; then
        # Wayland
        clipboard_cmd="wl-copy"
    fi

    # If clipboard tool is available, offer to copy
    if [[ -n "$clipboard_cmd" ]]; then
        echo "${DIM}[Ctrl+Y to copy response to clipboard, or press Enter to continue (5s timeout)]${RESET}"
        local key
        # Add 5 second timeout to prevent hanging, and handle Ctrl+C properly
        if read -rsn1 -t 5 key 2>/dev/null; then
            # Check if Ctrl+Y was pressed (ASCII 25)
            if [[ "$key" == $'\x19' ]]; then
                echo "$text" | $clipboard_cmd 2>/dev/null && {
                    echo "${GREEN}✓ Copied to clipboard${RESET}"
                } || {
                    echo "${YELLOW}⚠ Failed to copy${RESET}"
                }
            fi
        fi
        # If read times out or is interrupted (Ctrl+C), just return without error
        return 0
    fi
}

# Handle chat message
handle_chat_message() {
    local message="$1"
    local provider model
    provider="$(config_get model_provider)"
    model="$(config_get model_name)"

    # Show blinking cursor while API call runs (as requested by user)
    ui_blink "Thinking..."

    # Call API without stderr suppression to see errors
    local response
    response=$(call_api "$message" "$provider" "$model")
    local exit_code=$?

    # Clear the blinking cursor line
    ui_clear_line

    # Check if interrupted (exit code 130)
    if [[ $exit_code -eq 130 ]]; then
        echo ""
        return 130
    fi

    if [[ $exit_code -ne 0 ]]; then
        err "Failed to get response"
        return 1
    fi

    # Display response
    echo ""
    echo "${CYAN}${BOLD}AI:${RESET}"
    echo "$response"
    echo ""

    # Offer to copy to clipboard
    copy_to_clipboard "$response"

    # Track cost
    track_usage "$provider" "$model" "$message" "$response"
}

# Track API usage and costs
track_usage() {
    local provider="$1"
    local model="$2"
    local input="$3"
    local output="$4"

    local input_tokens output_tokens cost
    input_tokens=$(estimate_tokens "$input")
    output_tokens=$(estimate_tokens "$output")
    cost=$(calculate_cost "$provider" "$model" "$input_tokens" "$output_tokens")

    # Save to usage log
    local workspace logs_dir
    workspace="$(get_workspace)"
    logs_dir="$workspace/logs"
    local usage_log="$logs_dir/usage.jsonl"

    local entry
    entry=$(jq -n \
        --arg provider "$provider" \
        --arg model "$model" \
        --arg in_tokens "$input_tokens" \
        --arg out_tokens "$output_tokens" \
        --arg cost "$cost" \
        --arg timestamp "$(date -Iseconds)" \
        '{provider: $provider, model: $model, input_tokens: ($in_tokens | tonumber), output_tokens: ($out_tokens | tonumber), cost: ($cost | tonumber), timestamp: $timestamp}')

    echo "$entry" >> "$usage_log"

    # Show cost if enabled
    if [[ "$(config_get preferences.show_costs)" == "true" ]]; then
        debug "Cost: \$${cost} USD (${input_tokens} in + ${output_tokens} out tokens)"
    fi
}

