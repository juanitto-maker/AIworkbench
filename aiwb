# Quick one-shot generation with auto-verify
cmd_quick() {
    local description="$*"

    # If no description provided, prompt for it
    if [[ -z "$description" ]]; then
        description=$(ui_input "What do you want to create?")
        [[ -z "$description" ]] && return 0
    fi

    ui_header "Quick Generation"
    msg "Creating: $description"
    echo ""

    # Create temporary task
    local task_name="quick_$(date +%s)"
    local workspace tasks_dir
    workspace="$(get_workspace)"
    tasks_dir="$workspace/tasks"
    ensure_dir "$tasks_dir"

    local task_file="$tasks_dir/${task_name}.prompt.md"
    echo "$description" > "$task_file"

    # Set as current task
    config_set current_task "$task_name"

    # Check if should auto-verify
    local auto_verify="true"
    if [[ "$(config_get preferences.confirm_before_generate)" == "true" ]]; then
        if ! ui_confirm "Auto-verify with a different model?" "yes"; then
            auto_verify="false"
        fi
    fi

    # Generate
    cmd_generate "$task_name"

    # Auto-verify if enabled
    if [[ "$auto_verify" == "true" ]]; then
        echo ""
        msg "Auto-verifying with cross-provider review..."
        cmd_verify "$task_name"
    fi

    # Cleanup temporary task
    rm -f "$task_file"

    echo ""
    success "Done! Check outputs with: ./aiwb history"
}

# Interactive wizard workflow
cmd_wizard() {
    clear 2>/dev/null || true
    ui_header "AIWB Wizard"

    # Step 1: What to build
    local project_type
    project_type=$(ui_choose "What do you want to build?" \
        "Simple script/tool" \
        "Web application" \
        "API integration" \
        "Data processing pipeline" \
        "Documentation" \
        "Just chat/brainstorm" \
        "Cancel")

    [[ "$project_type" == "Cancel" || -z "$project_type" ]] && return 0

    # Step 2: Get description
    echo ""
    local description
    description=$(ui_input "Brief description of your project:")
    [[ -z "$description" ]] && return 0

    # Step 3: Choose language/technology (if applicable)
    local tech=""
    if [[ "$project_type" != "Just chat/brainstorm" && "$project_type" != "Documentation" ]]; then
        echo ""
        tech=$(ui_choose "Choose technology/language:" \
            "Bash/Shell" \
            "Python" \
            "JavaScript/Node.js" \
            "Go" \
            "Rust" \
            "Other/Mixed" \
            "Skip")
        [[ "$tech" == "Skip" ]] && tech=""
    fi

    # Step 4: Special requirements
    echo ""
    local requirements
    requirements=$(ui_input "Any special requirements? (optional)" "" "e.g., security, performance, compatibility")

    # Step 5: Build the prompt
    local full_prompt="$description"
    [[ -n "$tech" && "$tech" != "Skip" ]] && full_prompt="$full_prompt

Technology: $tech"
    [[ -n "$requirements" ]] && full_prompt="$full_prompt

Requirements:
$requirements"

    # Step 6: Show preview and confirm
    echo ""
    ui_header "Preview"
    echo "$full_prompt"
    echo ""

    if ! ui_confirm "Proceed with generation?" "yes"; then
        msg "Cancelled"
        return 0
    fi

    # Step 7: Choose workflow
    echo ""
    local workflow
    workflow=$(ui_choose "Choose workflow:" \
        "Quick (generate + verify)" \
        "Generate only" \
        "Full refinement loop (3 iterations)")

    # Execute
    echo ""
    case "$workflow" in
        "Quick"*)
            cmd_quick "$full_prompt"
            ;;
        "Generate only")
            local task_name="wizard_$(date +%s)"
            local workspace tasks_dir
            workspace="$(get_workspace)"
            tasks_dir="$workspace/tasks"
            ensure_dir "$tasks_dir"
            echo "$full_prompt" > "$tasks_dir/${task_name}.prompt.md"
            config_set current_task "$task_name"
            cmd_generate "$task_name"
            rm -f "$tasks_dir/${task_name}.prompt.md"
            ;;
        "Full refinement"*)
            local task_name="wizard_$(date +%s)"
            local workspace tasks_dir
            workspace="$(get_workspace)"
            tasks_dir="$workspace/tasks"
            ensure_dir "$tasks_dir"
            echo "$full_prompt" > "$tasks_dir/${task_name}.prompt.md"
            config_set current_task "$task_name"
            cmd_refine "$task_name" 3
            rm -f "$tasks_dir/${task_name}.prompt.md"
            ;;
    esac
}

# Make (alias for quick)
cmd_make() {
    cmd_quick "$@"
