# Generate content for task
cmd_generate() {
    local task="${1:-$(config_get current_task)}"
    [[ -z "$task" ]] && task="inbox"

    local workspace tasks_dir task_file
    workspace="$(get_workspace)"
    tasks_dir="$workspace/tasks"
    task_file="$tasks_dir/${task}.prompt.md"

    require_file "$task_file" "Task file"

    msg "Generating content for task: $task"

    # Read prompt
    local prompt
    prompt=$(cat "$task_file")

    # Estimate first
    if [[ "$(config_get preferences.auto_estimate)" == "true" ]]; then
        estimate_task "$task" "$prompt"

        if [[ "$(config_get preferences.confirm_before_generate)" == "true" ]]; then
            if ! ui_confirm "Proceed with generation?"; then
                msg "Cancelled"
                return 0
            fi
        fi
    fi

    # Generate
    local provider model
    provider="$(config_get model_provider)"
    model="$(config_get model_name)"

    echo ""
    msg "Generating with $provider ($model)..."

    local output
    output=$(call_api "$prompt" "$provider" "$model")

    # Save output
    local output_dir output_file
    output_dir="$workspace/outputs"
    ensure_dir "$output_dir"
    output_file="$output_dir/${task}_$(date +%Y%m%d_%H%M%S).md"

    echo "$output" > "$output_file"

    success "Generated content saved to: $output_file"

    # Show preview
    echo ""
    echo "${CYAN}${BOLD}Preview:${RESET}"
    echo "$output" | head -20
    if [[ $(echo "$output" | wc -l) -gt 20 ]]; then
        echo "... (truncated, see file for full output)"
    fi

    # Track usage
    track_usage "$provider" "$model" "$prompt" "$output"
}

# Estimate task cost
cmd_estimate() {
    local task="${1:-$(config_get current_task)}"
    [[ -z "$task" ]] && task="inbox"

    local workspace tasks_dir task_file
    workspace="$(get_workspace)"
    tasks_dir="$workspace/tasks"
    task_file="$tasks_dir/${task}.prompt.md"

    require_file "$task_file" "Task file"

    local prompt
    prompt=$(cat "$task_file")

    estimate_task "$task" "$prompt"
}

# Estimate task (helper)
estimate_task() {
    local task="$1"
    local prompt="$2"

    local provider model
    provider="$(config_get model_provider)"
    model="$(config_get model_name)"

    local input_tokens
    input_tokens=$(estimate_tokens "$prompt")

    # Estimate output tokens (rough: 2x input for generation tasks)
    local output_tokens=$((input_tokens * 2))

    # Calculate costs for different tiers
    local tier_mult
    declare -A tiers=(
        ["Basic"]="0.65"
        ["Medium"]="1.00"
        ["Best"]="1.60"
    )

    ui_header "Cost Estimate for: $task"

    echo "Provider: $provider"
    echo "Model:    $model"
    echo ""
    echo "Input tokens:  $input_tokens"
    echo ""

    if $GUM_AVAILABLE; then
        local rows=()
        for tier in Basic Medium Best; do
            mult="${tiers[$tier]}"
            est_out=$(awk "BEGIN {printf \"%.0f\", $output_tokens * $mult}")
            cost=$(calculate_cost "$provider" "$model" "$input_tokens" "$est_out")
            rows+=("${tier}\t${est_out}\t\$${cost}")
        done

        {
            echo "Tier\tOutput Tokens\tCost (USD)"
            printf '%s\n' "${rows[@]}"
        } | column -t -s $'\t'
    else
        printf "%-10s %-15s %s\n" "Tier" "Output Tokens" "Cost (USD)"
        echo "───────────────────────────────────────"
        for tier in Basic Medium Best; do
            mult="${tiers[$tier]}"
            est_out=$(awk "BEGIN {printf \"%.0f\", $output_tokens * $mult}")
            cost=$(calculate_cost "$provider" "$model" "$input_tokens" "$est_out")
            printf "%-10s %-15s \$%s\n" "$tier" "$est_out" "$cost"
        done
    fi
    echo ""
}

# Verify/review generated content
cmd_verify() {
    local task="${1:-$(config_get current_task)}"
    [[ -z "$task" ]] && task="inbox"

    local workspace output_dir
    workspace="$(get_workspace)"
    output_dir="$workspace/outputs"

    # Find latest output for task
    local latest
    latest=$(find "$output_dir" -name "${task}_*.md" -type f 2>/dev/null | sort -r | head -1)

    if [[ -z "$latest" ]]; then
        err "No generated output found for task: $task"
        return 1
    fi

    msg "Verifying: $latest"

    # Read output
    local content prompt
    content=$(cat "$latest")

    # Create verification prompt
    prompt="Review the following generated content and provide constructive feedback:

=== CONTENT TO REVIEW ===
$content

=== INSTRUCTIONS ===
Analyze for:
1. Quality and correctness
2. Completeness
3. Best practices
4. Potential improvements

Provide specific, actionable feedback."

    # Use different provider for verification if available
    local gen_provider verify_provider
    gen_provider="$(config_get model_provider)"

    case "$gen_provider" in
        gemini) verify_provider="claude" ;;
        claude) verify_provider="gemini" ;;
        *) verify_provider="$gen_provider" ;;
    esac

    if has_api_key "$verify_provider"; then
        msg "Using $verify_provider for verification (cross-provider review)"
    else
        verify_provider="$gen_provider"
        msg "Using $gen_provider for verification"
    fi

    # Get model
    local verify_model
    verify_model=$(get_default_model "$verify_provider")

    # Call verifier
    echo ""
    local feedback
    feedback=$(call_api "$prompt" "$verify_provider" "$verify_model")

    # Display feedback
    echo ""
    ui_info_box "VERIFICATION FEEDBACK" "info"
    echo ""
    echo "${CYAN}${BOLD}Feedback:${RESET}"
    echo "$feedback"
    echo ""

    # Save feedback
    local feedback_file="${latest%.md}.feedback.md"
    echo "$feedback" > "$feedback_file"
    success "Feedback saved to: $feedback_file"
}

# Automated Generator-Verifier loop
cmd_refine() {
    local task="${1:-$(config_get current_task)}"
    [[ -z "$task" ]] && task="inbox"

    local iterations="${2:-3}"

    ui_header "Auto-Refine: $task"

    msg "Running Generator-Verifier loop for $iterations iterations..."
    echo ""

    for ((i=1; i<=iterations; i++)); do
        msg "Iteration $i/$iterations"
        echo ""

        # Generate
        ui_style "→ Generating..." "cyan"
        cmd_generate "$task" || break

        # Verify
        echo ""
        ui_style "→ Verifying..." "magenta"
        cmd_verify "$task" || break

        # If not last iteration, update prompt with feedback
        if ((i < iterations)); then
            echo ""
            if ui_confirm "Continue to next iteration?"; then
                # TODO: Incorporate feedback into prompt
                sleep 1
            else
                break
            fi
        fi
    done

    echo ""
    success "Refinement complete!"
}

