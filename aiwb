# Build repository context automatically
build_repo_context() {
    local mode="${1:-selective}"  # selective or full
    local max_file_size=50000     # 50KB per file limit
    local context=""
    local file_count=0
    
    msg "Building $mode context for $(basename "$(pwd)")..."
    
    # Common exclusions (universal across all repo types)
    local exclude_patterns=(
        ".git"
        "node_modules"
        "dist"
        "build"
        "__pycache__"
        ".next"
        ".nuxt"
        "vendor"
        "target"
        "out"
        "bin"
        ".venv"
        "venv"
        "env"
        ".pytest_cache"
        ".mypy_cache"
        "coverage"
        ".DS_Store"
    )
    
    # Build find exclusions
    local find_exclude=""
    for pattern in "${exclude_patterns[@]}"; do
        find_exclude+=" -not -path '*/$pattern/*'"
    done
    
    if [[ "$mode" == "full" ]]; then
        # Full context: read most source files
        msg "Deep scan: reading all source files (this may take a moment)..."
        
        # Find source files (common extensions across languages)
        local source_extensions=(
            "*.js" "*.ts" "*.jsx" "*.tsx"
            "*.py" "*.go" "*.rs" "*.java"
            "*.c" "*.cpp" "*.h" "*.hpp"
            "*.rb" "*.php" "*.swift" "*.kt"
            "*.json" "*.yaml" "*.yml" "*.toml"
            "*.md" "*.txt" "*.sh" "*.bash"
            "Makefile" "Dockerfile" ".env*"
        )
        
        # Build name patterns for find
        local name_pattern=""
        for ext in "${source_extensions[@]}"; do
            [[ -n "$name_pattern" ]] && name_pattern+=" -o "
            name_pattern+="-name '$ext'"
        done
        
        # Execute find and process files
        eval "find . -type f $find_exclude \( $name_pattern \) 2>/dev/null" | while IFS= read -r file; do
            # Skip binary files
            if file "$file" 2>/dev/null | grep -q "text"; then
                local content
                content=$(head -c "$max_file_size" "$file" 2>/dev/null || true)
                if [[ -n "$content" ]]; then
                    context+=$'\n'"--- FILE: $file ---"$'\n'
                    context+="$content"$'\n'
                    ((file_count++))
                fi
            fi
        done
        
    else
        # Selective context: only key files (default mode)
        msg "Smart scan: reading key configuration and documentation files..."
        
        # Priority 1: Config files (always important)
        local config_files=(
            "package.json"
            "tsconfig.json"
            "*.config.js"
            "*.config.ts"
            "vite.config.*"
            "webpack.config.*"
            "rollup.config.*"
            "Cargo.toml"
            "go.mod"
            "go.sum"
            "requirements.txt"
            "Pipfile"
            "poetry.lock"
            "Gemfile"
            "composer.json"
            "pom.xml"
            "build.gradle"
            ".env.example"
            "config.yaml"
            "config.yml"
        )
        
        for pattern in "${config_files[@]}"; do
            eval "find . -maxdepth 2 -type f -name '$pattern' $find_exclude 2>/dev/null" | while IFS= read -r file; do
                local content
                content=$(head -c "$max_file_size" "$file" 2>/dev/null || true)
                if [[ -n "$content" ]]; then
                    context+=$'\n'"--- FILE: $file ---"$'\n'
                    context+="$content"$'\n'
                    ((file_count++))
                fi
            done
        done
        
        # Priority 2: Documentation
        eval "find . -maxdepth 2 -type f \( -name 'README*' -o -name 'CHANGELOG*' -o -name 'LICENSE*' -o -name 'CONTRIBUTING*' \) $find_exclude 2>/dev/null" | while IFS= read -r file; do
            local content
            content=$(head -c "$max_file_size" "$file" 2>/dev/null || true)
            if [[ -n "$content" ]]; then
                context+=$'\n'"--- FILE: $file ---"$'\n'
                context+="$content"$'\n'
                ((file_count++))
            fi
        done
        
        # Priority 3: Main source files (limited depth)
        local main_patterns=(
            "main.*"
            "index.*"
            "app.*"
            "server.*"
            "__init__.py"
            "mod.rs"
            "lib.rs"
        )
        
        for pattern in "${main_patterns[@]}"; do
            eval "find . -maxdepth 3 -type f -name '$pattern' $find_exclude 2>/dev/null" | while IFS= read -r file; do
                if file "$file" 2>/dev/null | grep -q "text"; then
                    local content
                    content=$(head -c "$max_file_size" "$file" 2>/dev/null || true)
                    if [[ -n "$content" ]]; then
                        context+=$'\n'"--- FILE: $file ---"$'\n'
                        context+="$content"$'\n'
                        ((file_count++))
                    fi
                fi
            done
        done
    fi
    
    msg "Context built: $file_count files scanned"
    echo "$context"
}

