# Settings menu
cmd_settings() {
    while true; do
        local provider model
        provider="$(config_get model_provider)"
        model="$(config_get model_name)"

        local choice
        choice=$(ui_choose "Settings Menu" \
            "Provider: $provider" \
            "Model: $model" \
            "Preferences" \
            "Cost Tracking" \
            "Security" \
            "Back")

        case "$choice" in
            "Provider:"*)
                local new_provider
                new_provider=$(ui_choose "Select Provider" "gemini" "claude" "openai" "groq" "ollama")
                [[ -n "$new_provider" ]] && {
                    config_set model_provider "$new_provider"
                    config_set model_name "$(get_default_model "$new_provider")"
                    success "Provider set to: $new_provider"
                }
                ;;
            "Model:"*)
                provider="$(config_get model_provider)"
                local models available
                available=$(get_available_models "$provider")
                local new_model
                new_model=$(ui_choose "Select Model" $available)
                [[ -n "$new_model" ]] && {
                    config_set model_name "$new_model"
                    success "Model set to: $new_model"
                }
                ;;
            "Preferences")
                settings_preferences
                ;;
            "Cost Tracking")
                settings_cost_tracking
                ;;
            "Security")
                settings_security
                ;;
            "Back"|"")
                break
                ;;
        esac
    done

    save_session
}

# Preferences settings
settings_preferences() {
    while true; do
        local auto_estimate confirm_gen show_costs
        auto_estimate="$(config_get preferences.auto_estimate)"
        confirm_gen="$(config_get preferences.confirm_before_generate)"
        show_costs="$(config_get preferences.show_costs)"

        local choice
        choice=$(ui_choose "Preferences" \
            "Auto-estimate: $auto_estimate" \
            "Confirm before generate: $confirm_gen" \
            "Show costs: $show_costs" \
            "Back")

        case "$choice" in
            "Auto-estimate:"*)
                [[ "$auto_estimate" == "true" ]] && auto_estimate="false" || auto_estimate="true"
                config_set preferences.auto_estimate "$auto_estimate"
                ;;
            "Confirm before generate:"*)
                [[ "$confirm_gen" == "true" ]] && confirm_gen="false" || confirm_gen="true"
                config_set preferences.confirm_before_generate "$confirm_gen"
                ;;
            "Show costs:"*)
                [[ "$show_costs" == "true" ]] && show_costs="false" || show_costs="true"
                config_set preferences.show_costs "$show_costs"
                ;;
            "Back"|"")
                break
                ;;
        esac
    done
}

# Cost tracking settings
settings_cost_tracking() {
    ui_info_box "Cost tracking helps you monitor API spending." "info"
    echo ""

    local budget
    budget=$(ui_input "Monthly budget (USD, 0 for unlimited)" "$(config_get cost_tracking.monthly_budget)")

    if [[ "$budget" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        config_set cost_tracking.monthly_budget "$budget"
        config_set cost_tracking.enabled "true"
        success "Budget set to \$$budget USD per month"
    fi
}

# Security settings
settings_security() {
    local choice
    choice=$(ui_choose "Security Settings" \
        "Run security audit" \
        "Encrypt API keys" \
        "Test API keys" \
        "Back")

    case "$choice" in
        "Run security audit")
            security_audit
            ;;
        "Encrypt API keys")
            encrypt_keys
            ;;
        "Test API keys")
            test_all_keys
            ;;
    esac
}

# Test all configured API keys
test_all_keys() {
    msg "Testing configured API keys..."
    echo ""

    for provider in gemini claude openai groq; do
        if has_api_key "$provider"; then
            test_api_key "$provider"
        else
            debug "Skipping $provider (no key configured)"
        fi
    done

    echo ""
    success "Key testing complete"
}

# Show session history
cmd_history() {
    local workspace logs_dir
    workspace="$(get_workspace)"
    logs_dir="$workspace/logs"

    if [[ ! -d "$logs_dir" ]] || [[ -z "$(ls -A "$logs_dir"/chat_*.log 2>/dev/null)" ]]; then
        info "No chat history found"
        return 0
    fi

    local logs
    logs=($(ls -t "$logs_dir"/chat_*.log 2>/dev/null))

    if have fzf; then
        local selected
        selected=$(printf '%s\n' "${logs[@]}" | fzf --preview 'cat {}')
        [[ -n "$selected" ]] && less "$selected"
    elif $GUM_AVAILABLE; then
        local selected
        selected=$(ui_filter "Select log to view" "${logs[@]}")
        [[ -n "$selected" ]] && less "$selected"
    else
        echo "Recent chat sessions:"
        ls -lht "$logs_dir"/chat_*.log | head -10
    fi
}

# Show cost breakdown
cmd_costs() {
    local workspace logs_dir usage_log
    workspace="$(get_workspace)"
    logs_dir="$workspace/logs"
    usage_log="$logs_dir/usage.jsonl"

    if [[ ! -f "$usage_log" ]]; then
        info "No usage data found"
        return 0
    fi

    ui_header "Cost Breakdown"

    # Total costs
    local total
    total=$(jq -s 'map(.cost) | add' "$usage_log" 2>/dev/null || echo "0")
    echo "Total spent: \$${total} USD"
    echo ""

    # By provider
    echo "By Provider:"
    jq -s 'group_by(.provider) | map({provider: .[0].provider, cost: (map(.cost) | add)}) | .[]' "$usage_log" 2>/dev/null | \
        jq -r '"\(.provider)\t\(.cost)"' | column -t

    echo ""

    # By date
    echo "Recent activity:"
    jq -s 'sort_by(.timestamp) | reverse | limit(10; .[]) | "\(.timestamp | split("T")[0])\t\(.provider)\t\(.cost)"' "$usage_log" 2>/dev/null | column -t
}

# System health check
cmd_doctor() {
    ui_header "System Health Check"

    # Check dependencies
    echo "Dependencies:"
    for cmd in bash jq curl git gum fzf age; do
        if have "$cmd"; then
            success "✓ $cmd installed"
        else
            warn "○ $cmd not installed (optional)" 2>/dev/null || echo "○ $cmd not installed (optional)"
        fi
    done

    echo ""

    # Check API keys
    echo "API Keys:"
    for provider in gemini claude openai groq; do
        if has_api_key "$provider"; then
            success "✓ $provider key configured"
        else
            info "○ $provider key not configured"
        fi
    done

    echo ""

    # Check workspace
    local workspace
    workspace="$(get_workspace)"
    echo "Workspace: $workspace"
    if [[ -d "$workspace" ]]; then
        success "✓ Workspace exists"
    else
        warn "⚠ Workspace not found"
    fi

    echo ""

    # Platform info
    echo "Platform:"
    echo "  OS: $(get_platform)"
    echo "  Arch: $(uname -m)"
    echo "  Shell: $SHELL"

    echo ""
    success "Health check complete"
}

# ============================================================================
# MAIN
# ============================================================================

main() {
    # Parse global flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --debug)
                export AIWB_DEBUG=1
                shift
                ;;
            --version|-v)
                echo "AIWB v2.0.0"
                exit 0
                ;;
            --help|-h)
                cmd_help
                exit 0
                ;;
            --provider)
                config_set model_provider "$2"
                shift 2
                ;;
            --model)
                config_set model_name "$2"
                shift 2
                ;;
            *)
                break
                ;;
        esac
    done

    # Initialize
    initialize

    # Route command
    local cmd="${1:-chat}"
    shift || true

    case "$cmd" in
        chat|c)
            cmd_chat "$@"
            ;;
        generate|gen|g)
            cmd_generate "$@"
            ;;
        estimate|est|e)
            cmd_estimate "$@"
            ;;
        verify|review)
            cmd_verify "$@"
            ;;
        refine|loop)
            cmd_refine "$@"
            ;;
        keys|key)
            cmd_keys "$@"
            ;;
        settings|config)
            cmd_settings "$@"
            ;;
        status|stat)
            ui_show_status
            ;;
        history|hist)
            cmd_history "$@"
            ;;
        costs|cost)
            cmd_costs "$@"
            ;;
        doctor|check)
            cmd_doctor "$@"
            ;;
        security-audit|audit)
            security_audit "$@"
            ;;
        help|--help|-h)
            cmd_help
            ;;
        *)
            err "Unknown command: $cmd"
            echo "Try: aiwb --help"
            exit 1
            ;;
    esac
}

# Run main
main "$@"
