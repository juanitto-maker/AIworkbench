# Generate content for task
cmd_generate() {
    local task="${1:-$(config_get current_task)}"
    [[ -z "$task" ]] && task="inbox"

    local workspace tasks_dir task_file
    workspace="$(get_workspace)"
    tasks_dir="$workspace/tasks"
    task_file="$tasks_dir/${task}.prompt.md"

    require_file "$task_file" "Task file"

    msg "Generating content for task: $task"

    # Read base prompt
    local base_prompt
    base_prompt=$(cat "$task_file")

    # Build complete prompt with all context (MODE_UPLOADS, etc.)
    local final_prompt
    final_prompt=$(build_prompt_with_context "$base_prompt" "false")

    # Check if we have context images for vision models
    local context_images=()
    if [[ ${#MODE_UPLOADS[@]} -gt 0 ]]; then
        while IFS= read -r img; do
            [[ -n "$img" ]] && context_images+=("$img")
        done < <(get_context_images)
    fi

    # Estimate first
    if [[ "$(config_get preferences.auto_estimate)" == "true" ]]; then
        estimate_task "$task" "$final_prompt"

        if [[ "$(config_get preferences.confirm_before_generate)" == "true" ]]; then
            if ! ui_confirm "Proceed with generation?"; then
                msg "Cancelled"
                return 0
            fi
        fi
    fi

    # Generate
    local provider model
    provider="$(config_get model_provider)"
    model="$(config_get model_name)"

    echo ""
    msg "Generating with $provider ($model)..."

    # Show context info if present
    if [[ ${#MODE_UPLOADS[@]} -gt 0 ]]; then
        local file_count=${#MODE_UPLOADS[@]}
        local image_count=${#context_images[@]}
        if [[ $image_count -gt 0 ]]; then
            info "Including context: $file_count file(s) ($image_count image(s))"
        else
            info "Including context: $file_count file(s)"
        fi
    fi

    local output
    # Use vision API if we have images
    if [[ ${#context_images[@]} -gt 0 ]]; then
        output=$(call_api_with_images "$final_prompt" "$provider" "$model" "" "${context_images[@]}")
    else
        output=$(call_api "$final_prompt" "$provider" "$model")
    fi

    # Save output
    local output_dir output_file
    output_dir="$workspace/outputs"
    ensure_dir "$output_dir"
    output_file="$output_dir/${task}_$(date +%Y%m%d_%H%M%S).md"

    echo "$output" > "$output_file"

    success "Generated content saved to: $output_file"

    # Show preview
    echo ""
    echo "${CYAN}${BOLD}Preview:${RESET}"
    echo "$output" | head -20
    if [[ $(echo "$output" | wc -l) -gt 20 ]]; then
        echo "... (truncated, see file for full output)"
    fi

    # Track usage
    track_usage "$provider" "$model" "$prompt" "$output"
}

